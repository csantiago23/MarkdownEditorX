@using Markdig
@using MarkdownEditorApp.Services
@using Microsoft.Maui.ApplicationModel.DataTransfer
@using Microsoft.Maui.Storage
@inject IFileService FileService
@inject IWindowService WindowService
@namespace MarkdownEditorApp.Components

<div class="workspace-container @(isDarkMode ? "dark-theme" : "light-theme")" @onkeydown="HandleKeyDown" tabindex="0">
    <header class="workspace-header">
        <div class="header-left">
            <img src="images/file_icon.png" class="app-logo-img" alt="Markdown Editor X" />
            <div class="file-menu-container">
                <button class="menu-trigger-btn @(isFileMenuOpen ? "active" : "")" @onclick="ToggleFileMenu">
                    File <span class="arrow-down">▾</span>
                </button>
                @if (isFileMenuOpen)
                {
                    <div class="dropdown-overlay" @onclick="CloseFileMenu"></div>
                    <ul class="file-dropdown-menu">
                        <li><button class="dropdown-item" @onclick="NewFileAction"><span class="shortcut">Ctrl+N</span>New File</button></li>
                        <li><button class="dropdown-item" @onclick="OpenFileAction"><span class="shortcut">Ctrl+O</span>Open File...</button></li>
                        <li class="menu-divider"></li>
                        <li><button class="dropdown-item" @onclick="SaveFileAction" disabled="@(!isDirty && FileService.CurrentFilePath != null)"><span class="shortcut">Ctrl+S</span>Save</button></li>
                        <li><button class="dropdown-item" @onclick="SaveFileAsAction">Save As...</button></li>
                        <li class="menu-divider"></li>
                        <li><button class="dropdown-item" @onclick="CloseFileAction">Close File</button></li>
                        <li><button class="dropdown-item close-editor-item" @onclick="CloseEditorAction">Close Editor</button></li>
                    </ul>
                }
            </div>
            <div class="header-divider"></div>
            <span class="file-name">@FileService.CurrentFileName</span>
            @if (isDirty)
            {
                <span class="dirty-dot" title="Unsaved changes">●</span>
            }
        </div>
        <div class="header-right">
            <button class="help-toggle-btn" @onclick="OpenHelpModal" title="Help & Guides">
                ❓ Help
            </button>
            <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Theme (Light / Dark)">
                @if (isDarkMode)
                {
                    <span>☀️ Light Mode</span>
                }
                else
                {
                    <span>🌙 Dark Mode</span>
                }
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner">
            <span class="error-message">⚠️ @errorMessage</span>
            <button class="close-error-btn" @onclick="ClearError">×</button>
        </div>
    }

    <div class="workspace-main">
        <!-- Editor Pane (Left) -->
        <div class="pane editor-pane">
            <textarea class="editor-textarea" 
                      placeholder="Type your markdown here..."
                      value="@markdownText" 
                      @oninput="OnMarkdownInput"
                      @ref="editorTextarea"></textarea>
        </div>

        <!-- Divider -->
        <div class="pane-divider"></div>

        <!-- Preview Pane (Right) -->
        <div class="pane preview-pane">
            <div class="preview-content">
                @if (string.IsNullOrWhiteSpace(markdownText))
                {
                    <span class="preview-placeholder">Live preview will appear here...</span>
                }
                else
                {
                    @compiledHtml
                }
            </div>
        </div>
    </div>

    <footer class="workspace-footer">
        <div class="footer-left">
            <span>Lines: <strong>@LineCount</strong></span>
            <span class="separator">|</span>
            <span>Words: <strong>@WordCount</strong></span>
        </div>
        <div class="footer-right">
            @if (isDirty)
            {
                <span class="status-indicator dirty">● Unsaved Changes</span>
            }
            else
            {
                <span class="status-indicator clean">✓ Saved</span>
            }
        </div>
    </footer>

    @if (isHelpModalOpen)
    {
        <div class="help-modal-overlay" @onclick="CloseHelpModal">
            <div class="help-modal-content" @onclick:stopPropagation>
                <header class="help-modal-header">
                    <div class="header-title-container">
                        <h3>Help & Resources</h3>
                        @if (!string.IsNullOrEmpty(copyFeedbackMessage))
                        {
                            <span class="copy-feedback-toast">✓ @copyFeedbackMessage</span>
                        }
                    </div>
                    <button class="help-modal-close-btn" @onclick="CloseHelpModal" title="Close Help">×</button>
                </header>
                
                <nav class="help-modal-tabs">
                    <button class="help-tab-btn @(activeHelpTab == "cheatsheet" ? "active" : "")" @onclick='() => SetHelpTab("cheatsheet")'>
                        📝 Markdown Cheat Sheet
                    </button>
                    <button class="help-tab-btn @(activeHelpTab == "userguide" ? "active" : "")" @onclick='() => SetHelpTab("userguide")'>
                        📘 App User Guide
                    </button>
                </nav>
                
                <div class="help-modal-body">
                    @if (activeHelpTab == "cheatsheet")
                    {
                        <div class="cheatsheet-container">
                            <p class="cheatsheet-intro">Click any card's copy button to copy the Markdown syntax to your clipboard.</p>
                            <div class="cheatsheet-grid">
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Headings</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("# Heading 1\n## Heading 2\n### Heading 3")'>Copy</button>
                                    </div>
                                    <pre><code># Heading 1
## Heading 2
### Heading 3</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Emphasis</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("**bold text**\n*italic text*\n***bold & italic***")'>Copy</button>
                                    </div>
                                    <pre><code>**bold text**
*italic text*
***bold & italic***</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Lists</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("- Unordered Item 1\n- Unordered Item 2\n\n1. Ordered Item 1\n2. Ordered Item 2")'>Copy</button>
                                    </div>
                                    <pre><code>- Unordered Item 1
- Unordered Item 2

1. Ordered Item 1
2. Ordered Item 2</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Links & Images</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("[Link Text](https://example.com)\n![Image Alt](images/file_icon.png)")'>Copy</button>
                                    </div>
                                    <pre><code>[Link Text](https://example.com)
![Image Alt](path/image.png)</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Code Blocks</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("`inline code`\n\n```csharp\n// Code block\nvar x = 10;\n```")'>Copy</button>
                                    </div>
                                    <pre><code>`inline code`

```csharp
// Code block
var x = 10;
```</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Blockquotes & Dividers</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("> This is a blockquote.\n\n---")'>Copy</button>
                                    </div>
                                    <pre><code>> This is a blockquote.

---</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Tables</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("| Header 1 | Header 2 |\n| -------- | -------- |\n| Cell 1   | Cell 2   |")'>Copy</button>
                                    </div>
                                    <pre><code>| Header 1 | Header 2 |
| -------- | -------- |
| Cell 1   | Cell 2   |</code></pre>
                                </div>
                                <div class="cheatsheet-card">
                                    <div class="card-header">
                                        <span class="card-title">Task Lists</span>
                                        <button class="copy-btn" @onclick='() => CopyToClipboard("- [x] Done task\n- [ ] Todo task")'>Copy</button>
                                    </div>
                                    <pre><code>- [x] Done task
- [ ] Todo task</code></pre>
                                </div>
                            </div>
                        </div>
                    }
                    else if (activeHelpTab == "userguide")
                    {
                        <div class="userguide-container">
                            <div class="pdf-viewer-header">
                                <span class="pdf-title">📄 App User Guide</span>
                                <button class="action-btn open-pdf-btn" @onclick="OpenGuideInSystemBrowser">
                                    📂 Open Guide in Browser
                                </button>
                            </div>
                            <div class="pdf-frame-wrapper">
                                <iframe src="user_guide.html" class="pdf-iframe"></iframe>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string markdownText = "";
    private string savedText = "";
    private bool isDirty = false;
    private string? errorMessage;
    private ElementReference editorTextarea;
    private MarkupString compiledHtml;
    
    private bool isHelpModalOpen = false;
    private string activeHelpTab = "cheatsheet";
    private string? copyFeedbackMessage;
    
    private bool isFileMenuOpen = false;
    private bool isDarkMode = true;
    
    private MarkdownPipeline markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override async Task OnInitializedAsync()
    {
        CompileMarkdown();
        if (!string.IsNullOrEmpty(FileService.CurrentFilePath))
        {
            await LoadInitialFileAsync();
        }
    }

    private async Task LoadInitialFileAsync()
    {
        try
        {
            if (System.IO.File.Exists(FileService.CurrentFilePath))
            {
                var content = await System.IO.File.ReadAllTextAsync(FileService.CurrentFilePath);
                markdownText = content;
                savedText = content;
                isDirty = false;
                errorMessage = null;
                CompileMarkdown();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load initial file: {ex.Message}";
        }
    }

    private void OnMarkdownInput(ChangeEventArgs e)
    {
        markdownText = e.Value?.ToString() ?? "";
        isDirty = markdownText != savedText;
        CompileMarkdown();
    }

    private void CompileMarkdown()
    {
        if (string.IsNullOrWhiteSpace(markdownText))
        {
            compiledHtml = new MarkupString(string.Empty);
            return;
        }

        try
        {
            var html = Markdown.ToHtml(markdownText, markdownPipeline);
            compiledHtml = new MarkupString(html);
        }
        catch (Exception ex)
        {
            errorMessage = $"Markdown parsing error: {ex.Message}";
        }
    }

    private void ToggleFileMenu()
    {
        isFileMenuOpen = !isFileMenuOpen;
    }

    private void CloseFileMenu()
    {
        isFileMenuOpen = false;
    }

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;
    }

    private void NewFileAction()
    {
        CloseFileMenu();
        NewFile();
    }

    private async Task OpenFileAction()
    {
        CloseFileMenu();
        await OpenFileAsync();
    }

    private async Task SaveFileAction()
    {
        CloseFileMenu();
        await SaveFileAsync();
    }

    private async Task SaveFileAsAction()
    {
        CloseFileMenu();
        await SaveFileAsAsync();
    }

    private void CloseFileAction()
    {
        CloseFileMenu();
        NewFile();
    }

    private void CloseEditorAction()
    {
        CloseFileMenu();
        WindowService.Close();
    }

    private async Task OpenFileAsync()
    {
        try
        {
            var content = await FileService.OpenFileAsync();
            if (content != null)
            {
                markdownText = content;
                savedText = content;
                isDirty = false;
                errorMessage = null;
                CompileMarkdown();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to open file: {ex.Message}";
        }
    }

    private async Task SaveFileAsync()
    {
        try
        {
            bool success = await FileService.SaveFileAsync(markdownText);
            if (success)
            {
                savedText = markdownText;
                isDirty = false;
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save file: {ex.Message}";
        }
    }

    private async Task SaveFileAsAsync()
    {
        try
        {
            bool success = await FileService.SaveFileAsAsync(markdownText);
            if (success)
            {
                savedText = markdownText;
                isDirty = false;
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save file as: {ex.Message}";
        }
    }

    private void NewFile()
    {
        markdownText = "";
        savedText = "";
        isDirty = false;
        errorMessage = null;
        FileService.CurrentFilePath = null;
        CompileMarkdown();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey)
        {
            if (e.Key == "s" || e.Key == "S")
            {
                await SaveFileAsync();
            }
            else if (e.Key == "o" || e.Key == "O")
            {
                await OpenFileAsync();
            }
            else if (e.Key == "n" || e.Key == "N")
            {
                NewFile();
            }
        }
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void OpenHelpModal()
    {
        isHelpModalOpen = true;
        activeHelpTab = "cheatsheet";
    }

    private void CloseHelpModal()
    {
        isHelpModalOpen = false;
    }

    private void SetHelpTab(string tab)
    {
        activeHelpTab = tab;
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(text);
            copyFeedbackMessage = "Copied to clipboard!";
            StateHasChanged();
            await Task.Delay(1500);
            copyFeedbackMessage = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to copy to clipboard: {ex.Message}";
        }
    }

    private async Task OpenGuideInSystemBrowser()
    {
        try
        {
            var basePath = AppContext.BaseDirectory;
            var htmlPath = Path.Combine(basePath, "wwwroot", "user_guide.html");
            
            if (File.Exists(htmlPath))
            {
                await Launcher.Default.OpenAsync(new OpenFileRequest
                {
                    File = new ReadOnlyFile(htmlPath)
                });
            }
            else
            {
                errorMessage = "Guide HTML file could not be found locally.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to open guide: {ex.Message}";
        }
    }

    private int WordCount => string.IsNullOrWhiteSpace(markdownText)
        ? 0
        : markdownText.Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries)
                      .Count(w => !string.IsNullOrWhiteSpace(w));

    private int LineCount => string.IsNullOrEmpty(markdownText)
        ? 1
        : markdownText.Split('\n').Length;
}
